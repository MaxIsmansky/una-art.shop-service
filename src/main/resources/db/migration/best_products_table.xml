<databaseChangeLog xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
                   xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
                   http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-3.8.xsd">

    <changeSet id="best-products-table" author="m.ismanskiy">
        <createTable tableName="best_products">
            <column name="uuid" type="UUID">
                <constraints primaryKey="true"/>
            </column>
            <column name="added_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP"/>
        </createTable>
        <addForeignKeyConstraint
                baseTableName="best_products"
                baseColumnNames="uuid"
                referencedTableName="products"
                referencedColumnNames="uuid"
                constraintName="fk_best_products_id"/>
    </changeSet>
</databaseChangeLog>
